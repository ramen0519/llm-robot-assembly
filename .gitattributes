* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pptx binary
*.pdf binary

# Preserve upstream model bytes and keep large mesh diffs compact.
models/universal_robots_ur3e/** -text
models/universal_robots_ur3e/assets/*.obj binary
models/universal_robots_ur3e/PROVENANCE.md text eol=lf

# Preserve the upstream Robotiq model snapshot.
models/robotiq_2f85/** -text
models/robotiq_2f85/assets/*.stl binary
models/robotiq_2f85/PROVENANCE.md text eol=lf
